{
  "name": "kontrol-zvonkov",
  "version": "1.0.0",
  "description": "Контроль звонков: записи звонков менеджеров → оценка по скрипту продаж, возражения, упущенные сделки, отчёты по менеджерам. 100% локально.",
  "type": "module",
  "bin": {
    "zvonki": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "node evals/run.mjs",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "call-analytics",
    "speech-analytics",
    "sales",
    "calls",
    "russian",
    "offline",
    "gigaam",
    "mcp",
    "claude"
  ],
  "author": "Egor Kozhevnikov (https://github.com/kozhevnikovai)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozhevnikovai/kontrol-zvonkov.git"
  },
  "homepage": "https://github.com/kozhevnikovai/kontrol-zvonkov#readme",
  "dependencies": {
    "@fontsource/geologica": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@kozhevnikovai/local-ai": "github:kozhevnikovai/local-ai#c4fbbb028a0fb3fdc7ffa913e59fdf58c1d9775c",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.2",
    "node-llama-cpp": "^3.22.3",
    "sherpa-onnx-node": "^2.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
